{
  "name": "brand-commerce",
  "version": "0.1.0",
  "private": true,
  "description": "Du an e-commerce full-stack TypeScript",
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:status": "docker compose ps",
    "dev:web": "pnpm --filter @brand/web dev",
    "build:web": "pnpm --filter @brand/web build",
    "lint:web": "pnpm --filter @brand/web exec eslint .",
    "dev:api": "pnpm --filter @brand/api start:dev",
    "build:api": "pnpm --filter @brand/api build",
    "lint:api": "pnpm --filter @brand/api lint",
    "test:api": "pnpm --filter @brand/api test --runInBand",
    "db:generate": "pnpm --filter @brand/api exec prisma generate",
    "db:status": "pnpm --filter @brand/api exec prisma migrate status",
    "db:seed": "pnpm --filter @brand/api exec prisma db seed",
    "typecheck:web": "pnpm --filter @brand/web typecheck",
    "typecheck:api": "pnpm --filter @brand/api typecheck",
    "typecheck": "pnpm typecheck:web && pnpm typecheck:api",
    "lint": "pnpm lint:web && pnpm lint:api",
    "test": "pnpm test:api",
    "build": "pnpm build:web && pnpm build:api",
    "check": "pnpm db:generate && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
}
}